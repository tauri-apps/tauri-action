    "smol-toml": "1.6.0",
    "string-argv": "0.3.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@types/node": "24.10.9",
    "@vercel/ncc": "0.38.4",
    "covector": "0.12.4",
    "eslint": "9.39.2",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.8.1",
    "typescript": "5.9.3",
